# Port on the host machine to bind the frontend Nginx reverse proxy
FRONTEND_PORT=80

# Allowed CORS origins for backend (e.g. your production domain or local host)
FRONTEND_ORIGIN=http://localhost

# Private Backend REST API Base URL (Python Flask)
# In local dev, Vite automatically proxies /api to http://127.0.0.1:5000.
# In production, leave empty if routing through Docker Nginx reverse proxy.
VITE_API_BASE_URL=

# Private Portal Backend URL (used by Node backend to forward /api/enquiries and auth)
# e.g. http://host.docker.internal:5000 or https://api.ecell.psgtech.ac.in
PRIVATE_BACKEND_URL=

# Google Sheets Backend Port (Node.js Express)
GSHEET_BACKEND_PORT=4000

# Google Sheets Configuration (Handled exclusively by the Node backend)
GSHEET_ID=your_google_spreadsheet_id_here
GSHEET_MEMBERS_RANGE=Members!A1:Z500
GSHEET_PROJECTS_RANGE=Projects!A1:Z500

# Google Cloud Service Account Credentials
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# NOTE: Wrap the private key in double quotes and preserve literal \n characters
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# In-Memory Cache TTL for Google Sheets responses (in seconds, default: 300)
CACHE_TTL_SECONDS=300

# Frontend mock mode flag (set to false for production / real backend API data)
VITE_USE_MOCK_API=false
