# Server Configuration
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:80

# Private Backend URL for forwarding /api/enquiries and auth (Optional)
PRIVATE_BACKEND_URL=http://127.0.0.1:5000

# Google Sheets Configuration
GSHEET_ID=your_google_spreadsheet_id_here
GSHEET_MEMBERS_RANGE=Members!A1:Z500
GSHEET_PROJECTS_RANGE=Projects!A1:Z500

# Google Cloud Service Account Credentials (Optional: if empty, uses public sheet CSV export)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# In-Memory Cache TTL (seconds)
CACHE_TTL_SECONDS=300
